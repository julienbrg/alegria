# Local development against the mock ENT: `cp .env.example .env`.
# In production, set NODE_ENV=production, ENT_MOCK=false, the real ENT
# values and public URLs, and a fresh SESSION_SECRET.

# Serves a fake ENT at /mock-ent; refused when NODE_ENV=production
ENT_MOCK=true
ENT_BASE_URL=http://localhost:3000/mock-ent
ENT_CLIENT_ID=alegria
ENT_CLIENT_SECRET=dev
ENT_REDIRECT_URI=http://localhost:5173/auth/callback
ENT_USERINFO_VERSION=2.0
ENT_ALLOWED_MODELS=mistral-large-latest,claude-sonnet-5-5
ENT_LOG_QUERIES=false

PUBLIC_ORIGIN=http://localhost:5173
# Development only; generate a real one with `openssl rand -base64 48`
SESSION_SECRET=dev-only-session-secret-change-me-0000
SESSION_IDLE_SECONDS=1800
SESSION_MAX_SECONDS=28800

# Questions per user and Paris day, by ENT profile; unlisted is unlimited
ASK_DAILY_LIMITS=Student:30,Parent:30,Personnel:100,Teacher:100
IMPORT_MAX_BYTES=20971520

MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# SQLite file, created on first start; `:memory:` keeps nothing on disk
DB_PATH=data/alegria.db

PORT=3000
NODE_ENV=development
SWAGGER_ENABLED=false

MCP_ENABLED=false
MCP_ROLES=teacher
# Lifetime of MCP access tokens; clients sign in again when one expires
MCP_TOKEN_SECONDS=3600
